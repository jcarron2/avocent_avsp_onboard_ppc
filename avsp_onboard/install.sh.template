#!/bin/sh
# install.sh -- fetches and installs the avsp-onboard companion daemon
# bundle in one shot. Generated by deploy_bundle.py -- the TFTP host/port
# and flash offset below are baked in from when it was built. If you're
# looking at {{...}} placeholders still in this file, you have the raw
# template, not a generated install.sh -- run deploy_bundle.py first.
#
# Usage, from a root shell on the device:
#   cd /tmp
#   tftp -g -r install.sh -l install.sh {{TFTP_HOST}} {{TFTP_PORT}}
#   sh install.sh
#
# Point your TFTP server at deploy_bundle.py's --outdir -- that's where
# this file, startup.sh, and flash_bundle_envelope.bin all land together,
# plus copies of flash_bundle_read_ppc and mtd_erase_write_ppc, so one
# directory serves everything this script needs.
#
# Not using `set -e`: mtd_erase_write_ppc (like every other small static
# binary this toolchain produces) hits a known, harmless SIGILL on clean
# exit -- under `set -e` that would abort the script right after the
# flash write, before ever starting the daemon. Each fetch is checked for
# real success explicitly instead (see fetch() below).

HOST="{{TFTP_HOST}}"
PORT="{{TFTP_PORT}}"
OFFSET="{{OFFSET}}"

fetch() {
    # fetch <remote-filename> <local-path>
    tftp -g -r "$1" -l "$2" "$HOST" "$PORT"
    if [ ! -s "$2" ]; then
        echo "[install] FAILED: $2 is empty or missing after fetching $1 from $HOST:$PORT"
        echo "[install] check the TFTP server is running and serving this directory -- aborting"
        exit 1
    fi
}

# Refuse to run against an already-live daemon rather than silently
# spawning a second one on top of it (this script's own final step below
# would otherwise re-launch watchdog.sh unconditionally, and two
# instances fighting over the same WS port looks exactly like external-
# viewer preemption from outside -- a real, previously-seen failure mode
# on this project with pkill -f, hence the explicit PID-based check here
# instead). Deliberately NOT auto-killing it: killing a live remote KVM
# session out from under whoever's using it should be a human decision,
# not something this script does silently. Redirecting `ps` output from a
# temp FILE (not piping into `while read`) is intentional -- piping into
# a while-loop runs it in a subshell on this shell, and PIDS set inside
# would be lost the moment the loop ends; `watchdog.sh`'s own
# `read ... < /proc/uptime` uses the same file-redirect-into-read pattern
# for the same reason.
PSFILE="/tmp/.install_check.$$"
ps | grep avsp_client_ppc | grep -v grep > "$PSFILE"
if [ -s "$PSFILE" ]; then
    PIDS=""
    while read -r pid rest; do
        PIDS="$PIDS $pid"
    done < "$PSFILE"
    rm -f "$PSFILE"
    echo "[install] avsp_client_ppc is already running (pid:$PIDS) -- refusing to continue."
    echo "[install] kill it first, then re-run this script, so the path is clear:"
    echo "[install]   kill -9$PIDS"
    exit 1
fi
rm -f "$PSFILE"

echo "[install] fetching from $HOST:$PORT ..."

mkdir -p /mnt/jffs

echo "[install] 1/5 flash_bundle_read -> /mnt/jffs (persists across reboots)"
fetch flash_bundle_read_ppc /mnt/jffs/flash_bundle_read
chmod +x /mnt/jffs/flash_bundle_read

echo "[install] 2/5 mtd_erase_write_ppc -> /tmp"
fetch mtd_erase_write_ppc /tmp/mtd_erase_write_ppc
chmod +x /tmp/mtd_erase_write_ppc

echo "[install] 3/5 startup.sh -> /mnt/jffs (persists across reboots)"
fetch startup.sh /mnt/jffs/startup.sh

echo "[install] 4/5 flash_bundle_envelope.bin -> /tmp, writing to flash (offset 0x$OFFSET)"
fetch flash_bundle_envelope.bin /tmp/flash_bundle_envelope.bin
/tmp/mtd_erase_write_ppc /dev/mtd1 "$OFFSET" /tmp/flash_bundle_envelope.bin

echo "[install] 5/5 starting the companion daemon now (no reboot needed to test)"
sh /mnt/jffs/startup.sh

echo "[install] done -- companion daemon starting. This install also"
echo "[install] survives reboots automatically from here on (auto_run ->"
echo "[install] startup.sh -> watchdog.sh, no manual step needed again)."
